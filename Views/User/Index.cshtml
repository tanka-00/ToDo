@{
    ViewBag.Title = "My tasks";
}

<div id="userApp"
     data-tasks-url="@Url.Action("GetTasks", "User")"
     data-save-url="@Url.Action("SaveTask", "User")"
     data-delete-url="@Url.Action("DeleteTask", "User")"
     data-toggle-url="@Url.Action("ToggleTask", "User")">

    <header class="page-head">
        <div class="page-head-copy">
            <p class="eyebrow">@ViewBag.DateLine</p>
            <h1>@ViewBag.Greeting, @ViewBag.FirstName.</h1>
            <p class="page-sub">A short list is a good place to start. Add one thing, then another.</p>
        </div>
        <button type="button" class="btn btn-primary" id="newTaskBtn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
            New task
        </button>
    </header>

    <section class="date-strip" aria-label="Today">
        <div class="date-marker" aria-hidden="true">
            <span class="date-day">@DateTime.Now.ToString("dd")</span>
            <span class="date-month">@DateTime.Now.ToString("MMM")</span>
        </div>
        <div class="date-copy">
            <p class="eyebrow">@DateTime.Now.ToString("dddd")</p>
            <p>Make a short list. Finish what matters.</p>
        </div>
        <div class="completion">
            <div class="completion-head">
                <span class="eyebrow">Your progress</span>
                <span class="mono" id="completionText">0 of 0 done</span>
            </div>
            <div class="meter" role="progressbar" aria-label="Task completion" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" id="completionMeter">
                <span id="completionBar" style="width: 0%"></span>
            </div>
        </div>
    </section>

    <section class="stats-strip" aria-label="Task summary">
        <div class="stat">
            <span class="stat-value" id="statOpen">0</span>
            <span class="stat-label">Open</span>
        </div>
        <div class="stat">
            <span class="stat-value" id="statDone">0</span>
            <span class="stat-label">Done</span>
        </div>
        <div class="stat">
            <span class="stat-value" id="statTotal">0</span>
            <span class="stat-label">Total</span>
        </div>
    </section>

    <section class="task-panel" aria-labelledby="taskPanelTitle">
        <div class="task-toolbar">
            <h2 class="sr-only" id="taskPanelTitle">Your tasks</h2>
            <div class="filter-chips" role="group" aria-label="Filter tasks">
                <button type="button" class="filter-chip is-active" data-filter="all" aria-pressed="true">All <span class="filter-count" data-count="all">0</span></button>
                <button type="button" class="filter-chip" data-filter="open" aria-pressed="false">Open <span class="filter-count" data-count="open">0</span></button>
                <button type="button" class="filter-chip" data-filter="done" aria-pressed="false">Done <span class="filter-count" data-count="done">0</span></button>
            </div>
        </div>

        <div id="taskList" class="task-list" aria-live="polite"></div>

        <div id="taskEmpty" class="empty-state" hidden>
            <span class="empty-icon" aria-hidden="true">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4" /><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" /></svg>
            </span>
            <h2 id="emptyTitle">Nothing here yet.</h2>
            <p id="emptyCopy">Add your first task and get the day moving.</p>
            <button type="button" class="btn btn-primary" id="emptyAddTask">Add a task</button>
        </div>

        <div id="taskLoading" class="task-loading">
            <span class="spinner spinner-dark" aria-hidden="true"></span>
            <span>Loading your tasks...</span>
        </div>
    </section>
</div>

<div class="modal fade" id="taskModal" tabindex="-1" aria-labelledby="taskModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="taskForm" novalidate>
                <div class="modal-header">
                    <div>
                        <p class="eyebrow" id="taskModalEyebrow">New task</p>
                        <h2 class="modal-title" id="taskModalLabel">What needs doing?</h2>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <input type="hidden" name="TaskId" id="TaskId" value="0" />

                    <div class="form-field">
                        <label for="Title">Task title</label>
                        <input type="text" class="form-control" id="Title" name="Title" maxlength="200" autocomplete="off" placeholder="e.g. Send the revised deck" />
                        <p class="field-error" id="TitleError" role="alert"></p>
                    </div>

                    <div class="form-field">
                        <label for="Description">Notes <span class="optional">(optional)</span></label>
                        <textarea class="form-control" id="Description" name="Description" rows="4" maxlength="1000" placeholder="Add a little context if it helps."></textarea>
                        <p class="field-hint"><span id="descriptionCount">0</span>/1000</p>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-ghost" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="saveTaskBtn">
                        <span class="btn-label">Add task</span>
                        <span class="spinner" hidden aria-hidden="true"></span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
