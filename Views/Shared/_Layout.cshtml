<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="login-url" content="@Url.Action("Login", "Account")" />
    <title>@ViewBag.Title · toDo</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=DM+Sans:opsz,wght@9..40,400..700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
    @Styles.Render("~/Content/base", "~/Content/user")
</head>
<body class="app-body user-body">
    <a class="skip-link" href="#mainContent">Skip to content</a>

    <header class="floating-navbar" id="floatingNavbar" role="banner">
        <div class="floating-navbar-inner">
            <div class="floating-navbar-brand">
                <a class="brand brand-floating" href="@Url.Action("Index", "User")" aria-label="toDo home">
                    <span class="brand-text">toDo</span>
                </a>
            </div>

            <div class="floating-navbar-actions">
                <div class="user-menu-wrap" id="userMenuDropdown">
                    <button type="button" class="nav-avatar-trigger" id="userMenuTrigger" aria-expanded="false" aria-haspopup="true" aria-label="User account menu for @ViewBag.DisplayName">
                        <span class="avatar avatar-circle avatar-nav">@ViewBag.Initials</span>
                    </button>

                    <div class="user-menu-popover" id="userMenuPopover" role="menu" aria-labelledby="userMenuTrigger" aria-hidden="true">
                        <div class="user-popover-profile">
                            <span class="avatar avatar-circle avatar-modal">@ViewBag.Initials</span>
                            <div class="user-popover-meta">
                                <strong>@ViewBag.DisplayName</strong>
                                <span>@User.Identity.Name</span>
                            </div>
                        </div>

                        <div class="user-popover-divider"></div>

                        <form class="logout-form" action="@Url.Action("Logout", "Account")" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="user-popover-logout" role="menuitem">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><path d="m16 17 5-5-5-5M21 12H9" /></svg>
                                <span>Sign out</span>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <div class="app-user-shell">
        <main class="page page-user" id="mainContent">
            @RenderBody()
        </main>
    </div>

    @Html.AntiForgeryToken()
    <div class="toast-stack" id="toastStack" aria-live="polite" aria-atomic="true"></div>
    @Html.Partial("_ConfirmModal")
    <noscript>
        <div class="noscript">This app needs JavaScript enabled to manage tasks.</div>
    </noscript>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @Scripts.Render("~/bundles/common")
    @Scripts.Render("~/bundles/user")
    @RenderSection("scripts", required: false)
</body>
</html>