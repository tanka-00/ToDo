@model toDo.Models.RegisterViewModel
@{
    ViewBag.Title = "Create account";
    ViewBag.AuthMode = "User";
}

<div class="auth-card">
    <p class="eyebrow">Start here</p>
    <h1>Create your account</h1>
    <p class="auth-sub">A short list is a good place to begin.</p>

    @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { @class = "auth-form", autocomplete = "on" }))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "form-alert", role = "alert" })

        <div class="form-field">
            @Html.LabelFor(m => m.Name, "Name")
            @Html.TextBoxFor(m => m.Name, new { @class = "form-control", autocomplete = "name", placeholder = "Your name" })
            @Html.ValidationMessageFor(m => m.Name, "", new { @class = "field-error" })
        </div>

        <div class="form-field">
            @Html.LabelFor(m => m.Email, "Email")
            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", autocomplete = "email", placeholder = "you@example.com" })
            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "field-error" })
        </div>

        <div class="form-field">
            @Html.LabelFor(m => m.Password, "Password")
            <div class="password-wrap">
                @Html.PasswordFor(m => m.Password, new { @class = "form-control", autocomplete = "new-password", placeholder = "At least 8 characters" })
                <button type="button" class="password-toggle" data-target="Password" aria-label="Show password" aria-pressed="false">
                    <svg class="eye-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" /><circle cx="12" cy="12" r="3" /></svg>
                    <svg class="eye-off" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 3 18 18M10.6 10.6a3 3 0 0 0 4.2 4.2M9.9 5.2A10.8 10.8 0 0 1 12 5c6.5 0 10 7 10 7a18 18 0 0 1-2.2 3.2M6.6 6.6C3.6 8.5 2 12 2 12s3.5 7 10 7a10.8 10.8 0 0 0 4.1-.8" /></svg>
                </button>
            </div>
            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "field-error" })
        </div>

        <div class="form-field">
            @Html.LabelFor(m => m.ConfirmPassword, "Confirm password")
            <div class="password-wrap">
                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", autocomplete = "new-password", placeholder = "Repeat your password" })
                <button type="button" class="password-toggle" data-target="ConfirmPassword" aria-label="Show password" aria-pressed="false">
                    <svg class="eye-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" /><circle cx="12" cy="12" r="3" /></svg>
                    <svg class="eye-off" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 3 18 18M10.6 10.6a3 3 0 0 0 4.2 4.2M9.9 5.2A10.8 10.8 0 0 1 12 5c6.5 0 10 7 10 7a18 18 0 0 1-2.2 3.2M6.6 6.6C3.6 8.5 2 12 2 12s3.5 7 10 7a10.8 10.8 0 0 0 4.1-.8" /></svg>
                </button>
            </div>
            @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "field-error" })
        </div>

        <button type="submit" class="btn btn-primary btn-block" data-loading-label="Creating account...">
            <span class="btn-label">Create account</span>
            <span class="spinner" hidden aria-hidden="true"></span>
        </button>
    }

    <p class="auth-switch">Already have an account? @Html.ActionLink("Sign in", "Login", "Account")</p>
</div>
